# ==============================================================================
# 🎨 TATOO AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Credentials (Hosted on Supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Eden AI Configuration (Chat Completions & Vision Model)
# Default model: openai/gpt-4o-mini
EDENAI_API_KEY=your-edenai-api-key
EDENAI_API_URL=https://api.edenai.run/v3/chat/completions
EDENAI_MODEL=openai/gpt-4o-mini

# EmailJS Configuration (Notifications, 48h reminders, newsletters)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_REMINDER=your-reminder-template-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_NEWSLETTER=your-newsletter-template-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_REENGAGEMENT=your-4months-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
